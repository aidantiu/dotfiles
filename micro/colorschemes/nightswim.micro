# Nightswim palette (nightswim/palette.sh). No background set, so the terminal's shows through.
color-link default "#d6cfe8"
color-link comment "#6b6f9a"
color-link identifier "#8cc4d4"
color-link constant "#d79bc9"
color-link constant.string "#86b3a0"
color-link constant.number "#d79bc9"
color-link symbol "#e8a95b"
color-link type "#8497d6"
color-link preproc "#9a8cc8"
color-link statement "#e8a95b"
color-link special "#9a8cc8"
color-link underlined "#8cc4d4"
color-link error "bold #c9566b"
color-link todo "bold #e8a95b"
color-link hlsearch "#0e1328,#e8a95b"
color-link statusline "#d6cfe8,#2a2f55"
color-link tabbar "#d6cfe8,#2a2f55"
color-link indent-char "#2a2f55"
color-link line-number "#6b6f9a"
color-link current-line-number "#e8a95b"
color-link diff-added "#86b3a0"
color-link diff-modified "#e8a95b"
color-link diff-deleted "#c9566b"
color-link gutter-error "#c9566b"
color-link gutter-warning "#e8a95b"
color-link cursor-line "#1a2040"
color-link color-column "#2a2f55"
color-link selection "#0e1328,#9a8cc8"
